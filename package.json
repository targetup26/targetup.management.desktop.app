{
    "name": "target-attendance",
    "version": "1.0.0",
    "description": "Targetup Employee Attendance Desktop App",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder"
    },
    "author": "Targetup",
    "license": "ISC",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "dependencies": {
        "axios": "^1.6.2",
        "electron-store": "^11.0.2",
        "socket.io-client": "^4.8.3"
    },
    "build": {
        "appId": "com.targetup.attendance",
        "productName": "Targetup Attendance",
        "win": {
            "target": [
                "nsis",
                "zip",
                "portable"
            ],
            "icon": "assets/icon.png",
            "verifyUpdateCodeSignature": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}